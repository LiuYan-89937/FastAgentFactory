{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Combo",
  "version": "1.1.4",
  "identifier": "top.liuyanai.combo",
  "build": {
    "beforeDevCommand": "cd web_frontend/frontend && npm run dev",
    "beforeBuildCommand": "node scripts/prepare_tauri_resources.mjs && cd web_frontend/frontend && npx vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web_frontend/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Combo",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python": "python",
      "resources/README.md": "README.md",
      "../combo": "combo",
      "../web_frontend/backend": "web_frontend/backend",
      "../web_frontend/frontend/dist": "web_frontend/dist"
    },
    "externalBin": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "copyright": "Copyright (c) 2026 Combo Team",
    "category": "DeveloperTool",
    "shortDescription": "动态智能体协作桌面应用",
    "longDescription": "Combo 是一个以本地工作区为核心的动态智能体协作与运行环境"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCRDlBRjkxMDM2MEZGMEYKUldRUC8yQURrYS9aKzVXRGZIeXJDTGxpMExNVjZ1d3ZvOVMzaG1rejNOUkcrVUhhR1VPSDNuNFkK",
      "endpoints": [
        "https://liuyanai.top/api/v1/app-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": true
    }
  }
}
